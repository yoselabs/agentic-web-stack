generator client {
  provider     = "prisma-client"
  output       = "../../src/generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  // In Prisma 7 the `url` property is no longer allowed in the schema.
  // Connection URL is supplied to the CLI via `prisma.config.ts` and to
  // the runtime client via the PrismaPg adapter in src/index.ts.
}
