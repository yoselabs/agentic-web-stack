{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    // TS 6 tightened lib resolution; the base config ships `lib: ["ESNext"]`
    // only. `fetch`/`URL`/`Request`/`Response` come from the DOM lib (same
    // shape as Node's global fetch). Adding "DOM" here keeps the package
    // usable from both browser and Node call sites.
    "lib": ["ESNext", "DOM"]
  },
  "include": ["src"]
}
