{
  // ═══════════════════════════════════════════════════════════════════════
  // THE canonical way to open this repo in VS Code.
  //
  // Open this FILE (not the folder) → labeled top-level view:
  // 🌐 apps/web · 🖥️ apps/server · ⚙️ apps/worker · 📦 each package ·
  // 🧪 e2e · 🛠️ scripts · 📄 docs · 🏠 root (configs only).
  //
  // All settings, extensions, and launch config live here — this is the
  // single source of truth. `.vscode/settings.json` is deliberately
  // absent; folder-mode (`code .`) gets VS Code defaults, which is fine
  // because this workspace file is the intended entrypoint.
  // ═══════════════════════════════════════════════════════════════════════

  "folders": [
    { "name": "🌐 apps/web", "path": "apps/web" },
    { "name": "🖥️  apps/server", "path": "apps/server" },
    { "name": "⚙️  apps/worker", "path": "apps/worker" },

    { "name": "📦 packages/api", "path": "packages/api" },
    { "name": "📦 packages/auth", "path": "packages/auth" },
    { "name": "📦 packages/db", "path": "packages/db" },
    { "name": "📦 packages/email", "path": "packages/email" },
    { "name": "📦 packages/env", "path": "packages/env" },
    { "name": "📦 packages/jobs", "path": "packages/jobs" },
    { "name": "📦 packages/rate-limit", "path": "packages/rate-limit" },
    { "name": "📦 packages/realtime", "path": "packages/realtime" },
    { "name": "📦 packages/test-infra", "path": "packages/test-infra" },
    { "name": "📦 packages/ui", "path": "packages/ui" },

    { "name": "🧪 e2e", "path": "e2e" },
    { "name": "🛠️  scripts", "path": "scripts" },
    { "name": "📄 docs", "path": "docs" },

    // Root last — a quick drop-in for config files. Its files.exclude
    // (folder-scoped below) hides apps/packages/e2e/scripts/docs so the
    // Explorer view for this folder shows just the root configs.
    { "name": "🏠 root", "path": "." }
  ],

  "settings": {
    // ─────────────────────────────────────────────────────────────
    // FILE NESTING — 20+ root dotfiles collapse under `package.json`
    // in Explorer. Click the caret to expand; nothing is truly hidden.
    // ─────────────────────────────────────────────────────────────
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
      "package.json": "pnpm-lock.yaml, pnpm-workspace*.yaml, .npmrc, .nvmrc, .node-version, .pre-commit-config.yaml, .agent-harness.yml, turbo.json, knip.json, biome.json, .cspell.json, .cspell, .markdownlint*, .lychee.toml, .jscpd.json, .dependency-cruiser.cjs, .prismalintrc.json, .secretlintrc.json, .secretlintignore, .yamllint.yml, .duplicate-names-allow.json, .test-siblings-allow.json, .scoped-landmarks-allow.json, .perspective-boundary.json, .gitignore, .dockerignore, Makefile",
      "tsconfig.json": "tsconfig.*.json, tsconfig.tsbuildinfo",
      "Dockerfile": "docker-compose*.yml, .dockerignore",
      ".env": ".env.*",
      ".env.example": ".env, .env.*",
      "README.md": "CLAUDE.md, LICENSE, TODO.md, DEPLOYMENT.md, CHANGELOG.md",
      "*.ts": "${capture}.test.ts, ${capture}.spec.ts, ${capture}.d.ts",
      "*.tsx": "${capture}.test.tsx, ${capture}.stories.tsx, ${capture}.browser.test.tsx, ${capture}.spec.tsx"
    },

    // ─────────────────────────────────────────────────────────────
    // EXPLORER / SEARCH / WATCHER — hide generated + cache dirs.
    // ─────────────────────────────────────────────────────────────
    "files.exclude": {
      // Root-folder scoped: when the "🏠 root" folder is in view, these
      // disappear because they already have dedicated folders above.
      "apps": true,
      "packages": true,
      "e2e": true,
      "scripts": true,
      "docs": true,
      // Universal: generated / cached artifacts should never be browsed.
      "**/.turbo": true,
      "**/.tsbuildinfo": true,
      "**/node_modules": true,
      "**/.features-gen": true,
      "**/.tanstack": true,
      "**/storybook-static": true,
      "**/.lost-pixel": true,
      "**/dist": true,
      "**/.output": true,
      "**/.vinxi": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.output": true,
      "**/.features-gen": true,
      "**/generated": true,
      "**/src/generated": true,
      "**/routeTree.gen.ts": true,
      "**/pnpm-lock.yaml": true,
      "**/storybook-static": true,
      "**/.lost-pixel": true,
      "**/.turbo": true,
      "**/test-results": true,
      "**/.claude/worktrees": true
    },
    "files.watcherExclude": {
      "**/.turbo/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/.output/**": true,
      "**/.features-gen/**": true,
      "**/generated/**": true,
      "**/storybook-static/**": true,
      "**/.lost-pixel/**": true,
      "**/test-results/**": true
    },

    // ─────────────────────────────────────────────────────────────
    // FORMAT + LINT — Biome owns TS/JS/JSON/CSS. Format on save.
    // ─────────────────────────────────────────────────────────────
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "quickfix.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    },
    "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
    "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
    "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
    "[javascriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
    "[json]": { "editor.defaultFormatter": "biomejs.biome" },
    "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
    "[css]": { "editor.defaultFormatter": "biomejs.biome" },
    "[markdown]": {
      "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
      "editor.formatOnSave": false
    },
    "[prisma]": { "editor.defaultFormatter": "Prisma.prisma" },
    "[yaml]": { "editor.defaultFormatter": "redhat.vscode-yaml" },
    "[dockerfile]": {
      "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "prettier.enable": false,
    "eslint.enable": false,

    // ─────────────────────────────────────────────────────────────
    // TYPESCRIPT — workspace version + inlay hints for AI-readability.
    // ─────────────────────────────────────────────────────────────
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "typescript.preferences.importModuleSpecifier": "non-relative",
    "typescript.preferences.preferTypeOnlyAutoImports": true,
    "typescript.inlayHints.parameterNames.enabled": "literals",
    "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
    "typescript.updateImportsOnFileMove.enabled": "always",

    // ─────────────────────────────────────────────────────────────
    // EDITOR ergonomics — tabs, rulers, sticky scroll, linked editing.
    // ─────────────────────────────────────────────────────────────
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.rulers": [100],
    "editor.wordWrap": "off",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.stickyScroll.enabled": true,
    "editor.linkedEditing": true,

    // ─────────────────────────────────────────────────────────────
    // TEST / TERMINAL — Bun + Vitest + Playwright integration.
    // ─────────────────────────────────────────────────────────────
    "terminal.integrated.env.osx": { "BUN_INSTALL": "$HOME/.bun" },
    "testing.openTesting": "neverOpen",
    "vitest.disableWorkspaceWarning": true,
    "playwright.reuseBrowser": true,
    "playwright.env": { "TEST_MODE": "1" },

    // ─────────────────────────────────────────────────────────────
    // CSPELL — use the repo dict, not the global one.
    // ─────────────────────────────────────────────────────────────
    "cSpell.enabled": true,
    "cSpell.customDictionaries": {
      "project-words": {
        "name": "project-words",
        "path": "${workspaceFolder:🏠 root}/.cspell/custom-words.txt",
        "addWords": true,
        "scope": "workspace"
      }
    },

    // ─────────────────────────────────────────────────────────────
    // GIT — never smart-commit without explicit staging.
    // ─────────────────────────────────────────────────────────────
    "git.enableSmartCommit": false,
    "git.confirmSync": false,
    "git.autofetch": true,
    "git.pruneOnFetch": true,

    // ─────────────────────────────────────────────────────────────
    // WORKBENCH
    // ─────────────────────────────────────────────────────────────
    "workbench.tree.indent": 12,
    "workbench.editor.labelFormat": "short",
    "explorer.sortOrder": "type"
  },

  "extensions": {
    "recommendations": [
      "biomejs.biome",
      "Prisma.prisma",
      "bradlc.vscode-tailwindcss",
      "cucumberopen.cucumber-official",
      "redhat.vscode-yaml",
      "tamasfe.even-better-toml",
      "ms-azuretools.vscode-docker",
      "ms-playwright.playwright",
      "vitest.explorer",
      "DavidAnson.vscode-markdownlint",
      "streetsidesoftware.code-spell-checker",
      "eamodio.gitlens",
      "mikestead.dotenv"
    ],
    "unwantedRecommendations": [
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint"
    ]
  }
}
