{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./cspell/custom-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words"],
  "ignorePaths": [
    "node_modules/**",
    "**/node_modules/**",
    "dist/**",
    "**/dist/**",
    ".output/**",
    "**/.output/**",
    ".turbo/**",
    "**/.turbo/**",
    "generated/**",
    "**/generated/**",
    "**/routeTree.gen.ts",
    "pnpm-lock.yaml",
    ".features-gen/**",
    "**/.features-gen/**",
    ".claude/worktrees/**",
    "CHANGELOG.md",
    "**/CHANGELOG.md"
  ]
}
