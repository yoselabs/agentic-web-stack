import type { Prisma, PrismaClient } from "@project/db";

type DbClient = PrismaClient | Prisma.TransactionClient;

export type {{pascalCase name}}Summary = {
  name: string;
  ownerId: string;
};

/**
 * Example read. Replace with `db.<model>.findMany(...)` once the Prisma
 * schema for this domain lands.
 */
export async function list{{pascalCase name}}s(
  db: DbClient,
  userId: string,
): Promise<{{pascalCase name}}Summary[]> {
  // Reference `db` so linters don't flag it unused before the real query
  // is filled in. `$queryRaw\`SELECT 1\`` is a no-op validation ping.
  await db.$queryRaw`SELECT 1`;
  return [{ name: "{{name}}", ownerId: userId }];
}

/**
 * Example mutation. Accepts `tx: Prisma.TransactionClient` per the
 * transaction-discipline convention; the router MUST call this inside
 * `ctx.db.$transaction((tx) => create{{pascalCase name}}(tx, ...))`.
 */
export async function create{{pascalCase name}}(
  tx: Prisma.TransactionClient,
  userId: string,
  name: string,
): Promise<{{pascalCase name}}Summary> {
  await tx.$queryRaw`SELECT 1`;
  return { name, ownerId: userId };
}
