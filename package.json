{
  "name": "agentic-web-stack",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @project/web --filter @project/server --filter @project/worker dev",
    "new:feature": "turbo gen feature",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:biome": "agent-harness lint",
    "lint:tsc": "tsc -b",
    "lint:check:no-barrel": "bun scripts/checks/check-no-barrel.ts",
    "lint:check:server-bind": "bun scripts/checks/check-server-bind.ts",
    "lint:check:domain-names": "bun scripts/checks/check-domain-names.ts",
    "lint:check:trpc-patterns": "bun scripts/checks/check-trpc-patterns.ts",
    "lint:check:test-infra-integrity": "bun scripts/checks/check-test-infra-integrity.ts",
    "lint:check:feature-emails": "bun e2e/scripts/check-feature-emails.ts",
    "lint:check:duplicate-names": "bun scripts/checks/check-duplicate-names.ts",
    "lint:check:no-cwd": "bun scripts/checks/check-no-cwd.ts",
    "lint:check:test-siblings": "bun scripts/checks/check-test-siblings.ts",
    "lint:check:stories-siblings": "bun scripts/checks/check-stories-siblings.ts",
    "lint:check:env-example": "bun scripts/checks/check-env-example.ts",
    "lint:prisma": "prisma-lint --config .config/prismalint.json packages/db/prisma/schema/",
    "lint:knip": "knip --exclude exports,types,nsExports,nsTypes,enumMembers --no-config-hints",
    "lint:jscpd": "jscpd --config .config/jscpd.json",
    "lint:sherif": "sherif",
    "lint:publint": "pnpm -r --workspace-concurrency=1 exec publint",
    "lint:depcruise": "depcruise --config .config/dependency-cruiser.cjs apps packages",
    "lint:secretlint": "secretlint --secretlintrc .config/secretlint.json \"**/*\"",
    "lint:actionlint": "./scripts/wrappers/run-actionlint.sh",
    "lint:markdown": "markdownlint-cli2 --config .config/markdownlint.jsonc",
    "lint:links": "./scripts/wrappers/run-lychee.sh",
    "lint:spell": "cspell --config .config/cspell.json --gitignore --no-progress \"**/*.{md,ts,tsx}\"",
    "lint:shell": "./scripts/wrappers/run-shellcheck.sh",
    "lint:check:adrs": "bun scripts/checks/check-adrs.ts",
    "lint:check:state-machines": "bun scripts/checks/lint-state-machines.ts",
    "lint:check:pitch-coverage": "bun scripts/checks/check-pitch-coverage.ts",
    "lint:check:scoped-landmarks": "bun scripts/checks/check-scoped-landmarks.ts",
    "lint:check:perspective-boundary": "bun scripts/checks/check-perspective-boundary.ts",
    "db:generate": "pnpm --filter @project/db generate",
    "db:push": "pnpm --filter @project/db push",
    "db:studio": "pnpm --filter @project/db studio",
    "db:seed": "bun scripts/seed/seed.ts"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@cucumber/gherkin": "^39.0.0",
    "@cucumber/messages": "^32.3.1",
    "@project/auth": "workspace:*",
    "@project/db": "workspace:*",
    "@project/test-infra": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "^12.1.0",
    "@tanstack/router-generator": "^1.166.29",
    "@turbo/gen": "^2.9.6",
    "cspell": "^10.0.0",
    "dependency-cruiser": "^17.3.10",
    "gray-matter": "^4.0.3",
    "jscpd": "^4.0.9",
    "knip": "^6.5.0",
    "markdownlint-cli2": "^0.22.0",
    "prisma-lint": "^0.13.1",
    "publint": "^0.3.18",
    "secretlint": "^12.1.0",
    "sherif": "^1.11.1",
    "ts-morph": "catalog:",
    "turbo": "^2.9.6",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
